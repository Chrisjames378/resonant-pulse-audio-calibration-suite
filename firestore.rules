rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /calibrationProfiles/{profileId} {
      allow read, write: if true;
    }

    match /eqPresets/{presetId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
